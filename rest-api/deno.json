{
  "name": "@scope/rest-api",
  "version": "0.0.1",
  "exports": "./main.ts",
  "imports": {
    "@hono/zod-validator": "jsr:@hono/zod-validator@^0.8.0",
    "@zod/zod": "jsr:@zod/zod@^4.4.3",
    "hono": "jsr:@hono/hono@^4.12.21",
    "http-status-codes": "npm:http-status-codes@^2.3.0"
  },
  "tasks": {
    "start": "deno run -N -R -W -E -S --allow-ffi --env-file=\"../.env\" --watch main.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
