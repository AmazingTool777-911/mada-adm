# PostgreSQL connection settings
# These variables map 1-to-1 with the --<flag> CLI arguments accepted by
# the extract-adm-inputs script.  CLI flags always take precedence over
# environment variables when both are provided.
#
# Connection mode — pick ONE of the two sections below:
#
#   URL mode   : set PG_URL (or pass --url).  All individual fields are ignored.
#   Config mode: leave PG_URL unset and fill in the individual fields instead.

# The target database type. Either sqlite, mysql, postgres, or mongodb.
DB_TYPE=sqlite

# --cli-debug : Enable debug mode ("true" / "1" = enabled, default = disabled).
CLI_DEBUG=false

# ── URL mode ────────────────────────────────────────────────────────────────
# --pg.url  : Full PostgreSQL connection URL.
#             Format: postgres://<user>:<password>@<host>:<port>/<database>
#             When set, all individual config fields below are ignored.
PG_URL=

# ── Config mode (used when PG_URL is not set) ───────────────────────────────

# --pg.host  : Hostname or IP address of the PostgreSQL server.
PG_HOST=localhost

# --pg.port  : TCP port the PostgreSQL server listens on.
PG_PORT=5432

# --pg.user  : Username to authenticate with.
PG_USER=postgres

# --pg.password  : Password for the above user.
PG_PASSWORD=

# --pg.database  : Name of the target database.
PG_DATABASE=postgres

# --pg.schema  : Name of the physical database schema (default: public).
PG_SCHEMA=public

# --pg.ssl  : Enable SSL for the connection ("true" / "1" = enabled, anything else = disabled).
#             Omit entirely to leave SSL unset (driver default applies).
PG_SSL=false

# --pg.ca-cert-file  : Filename of the CA certificate stored under db/.ca-certificates/.
#                      NOTE: This only works when running from the Deno codebase;
#                      it is not supported in the compiled binary. Use PG_CA_CERT_PATH instead.
PG_CA_CERT_FILE=

# --pg.ca-cert-path  : Full path to the CA certificate file on disk.
#                      Used when PG_CA_CERT_FILE is not set and PG_SSL is enabled.
PG_CA_CERT_PATH=

# --pg.connection-limit : Maximum number of connections in the PostgreSQL pool (default 10).
PG_CONNECTION_LIMIT=10

# ── SQLite connection settings ──────────────────────────────────────────────
# These variables map 1-to-1 with the --sqlite.<flag> CLI arguments.
# CLI flags always take precedence over environment variables.
#
# Connection mode — pick ONE of the two below:
#
#   File mode : set SQLITE_DB_FILE (or pass --sqlite.db-file).
#               The file will be looked up in the db/.sqlite directory.
#   Path mode : set SQLITE_DB_PATH (or pass --sqlite.db-path).
#               Full absolute or relative path to the SQLite database file.

# --sqlite.db-file : Filename of the SQLite database within db/.sqlite.
#                  NOTE: This only works when running from the Deno codebase;
#                  it is not supported in the compiled binary. Use SQLITE_DB_PATH instead.
SQLITE_DB_FILE=mada-adm.db

# --sqlite.db-path : Full path to the SQLite database file on disk.
SQLITE_DB_PATH=

# ── MySQL connection settings ───────────────────────────────────────────────
# These variables map 1-to-1 with the --mysql.<flag> CLI arguments.
# CLI flags always take precedence over environment variables.
#
# Connection mode — pick ONE of the two below:
#
#   URL mode   : set MYSQL_URL (or pass --mysql.url). All individual fields are ignored.
#   Config mode: leave MYSQL_URL unset and fill in the individual fields instead.

# --mysql.url : Full MySQL connection URL.
#               Format: mysql://<user>:<password>@<host>:<port>/<database>
MYSQL_URL=

# --mysql.host : Hostname or IP address of the MySQL server.
MYSQL_HOST=localhost

# --mysql.port : TCP port the MySQL server listens on (default 3306).
MYSQL_PORT=3306

# --mysql.user : Username to authenticate with (default root).
MYSQL_USER=root

# --mysql.password : Password for the above user.
MYSQL_PASSWORD=

# --mysql.database : Name of the target database (default mysql).
MYSQL_DATABASE=mysql

# --mysql.ssl : Enable SSL for the connection ("true" / "1" = enabled).
MYSQL_SSL=false

# --mysql.ca-cert-file : Filename of the CA certificate under db/.ca-certificates/.
#                        NOTE: This only works when running from the Deno codebase.
MYSQL_CA_CERT_FILE=

# --mysql.ca-cert-path : Full path to the CA certificate file on disk.
MYSQL_CA_CERT_PATH=

# --mysql.cert-file : Filename of the client certificate under db/.ca-certificates/.
#                    NOTE: This only works when running from the Deno codebase.
MYSQL_CERT_FILE=

# --mysql.cert-path : Full path to the client certificate file on disk.
MYSQL_CERT_PATH=

# --mysql.key-file : Filename of the client key under db/.ca-certificates/.
#                   NOTE: This only works when running from the Deno codebase.
MYSQL_KEY_FILE=

# --mysql.key-path : Full path to the client key file on disk.
MYSQL_KEY_PATH=

# --mysql.connection-limit : Maximum number of connections in the MySQL pool (default 10).
MYSQL_CONNECTION_LIMIT=10

# --mysql.max-idle : Maximum number of idle connections in the MySQL pool.
MYSQL_MAX_IDLE=

# --mysql.connection-limit : The maximum time a connection can sit unused in the pool before being closed.
MYSQL_IDLE_TIMEOUT=

# ── MongoDB connection settings ──────────────────────────────────────────────
# These variables map 1-to-1 with the --mongo.<flag> CLI arguments.
# CLI flags always take precedence over environment variables.
#
# Connection mode: set MONGO_URI (or pass --mongo.uri).

# --mongo.uri : Full MongoDB connection URI.
#               Format: mongodb://<user>:<password>@<host>:<port>/<database>
MONGO_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/mada_adm?replicaSet=rs0

# --mongo.pool-size : Maximum number of connections in the MongoDB pool (default 10).
MONGO_POOL_SIZE=10

# --mongo.database : Name of the target MongoDB database (optional if present in URI).
MONGO_DATABASE=mada_adm

# --mongo.tls : Enable TLS for the connection ("true" / "1" = enabled).
MONGO_TLS=false

# --mongo.tls-ca-file : Filename of the CA certificate under db/.ca-certificates/.
#                       NOTE: This only works when running from the Deno codebase.
MONGO_TLS_CA_FILE=

# --mongo.tls-ca-path : Full path to the CA certificate file on disk.
MONGO_TLS_CA_PATH=

# --mongo.tls-certificate-key-file : Filename of the client certificate and key PEM file under db/.ca-certificates/.
#                                    NOTE: This only works when running from the Deno codebase.
MONGO_TLS_CERT_KEY_FILE=

# --mongo.tls-certificate-key-path : Full path to the client certificate and key PEM file on disk.
MONGO_TLS_CERT_KEY_PATH=

# --mongo.tls-certificate-key-file-password : Password for the client certificate key file if it is encrypted.
MONGO_TLS_CERT_PASSWORD=

# --mongo.tls-allow-invalid-certificates : Whether to allow invalid certificates for the connection.
MONGO_TLS_ALLOW_INVALID_CERTIFICATES=false

# --mongo.tls-allow-invalid-hostnames : Whether to allow invalid hostnames for the connection.
MONGO_TLS_ALLOW_INVALID_HOSTNAMES=false

# ── Redis connection settings ──────────────────────────────────────────────
# These variables map 1-to-1 with the --redis-<flag> CLI arguments accepted by
# the extract-adm-inputs script.  CLI flags always take precedence over
# environment variables when both are provided.
#
# Connection mode — pick ONE of the two sections below:
#
#   URL mode   : set REDIS_URL (or pass --redis-url).  All individual fields are ignored.
#   Config mode: leave REDIS_URL unset and fill in the individual fields instead.

# ── URL mode ────────────────────────────────────────────────────────────────
# --redis-url : Full Redis connection URL.
#               Format: redis://<user>:<password>@<host>:<port>/<db-index>
#               When set, all individual config fields below are ignored.
REDIS_URL=

# ── Config mode (used when REDIS_URL is not set) ───────────────────────────

# --redis-host : Hostname or IP address of the Redis server.
REDIS_HOST=localhost

# --redis-port : TCP port the Redis server listens on.
REDIS_PORT=6379

# --redis-username : Optional username to authenticate with.
REDIS_USERNAME=

# --redis-password : Optional password for the above user.
REDIS_PASSWORD=

# --redis-db : Optional database index (default 0).
REDIS_DB=0

# --redis-ssl : Enable TLS/SSL for the connection ("true" / "1" = enabled, anything else = disabled).
REDIS_SSL=false
 
# --redis.cert-file : Filename of the client certificate under redis/.ca-certificates/.
#                    NOTE: This only works when running from the Deno codebase;
#                    it is not supported in the compiled binary. Use REDIS_CERT_PATH instead.
REDIS_CERT_FILE=

# --redis.cert-path : Full path to the client certificate file on disk.
REDIS_CERT_PATH=
 
# --redis.key-file : Filename of the client key under redis/.ca-certificates/.
#                   NOTE: This only works when running from the Deno codebase;
#                   it is not supported in the compiled binary. Use REDIS_KEY_PATH instead.
REDIS_KEY_FILE=

# --redis.key-path : Full path to the client key file on disk.
REDIS_KEY_PATH=
 
# --redis.ca-cert-file : Filename of the CA certificate under redis/.ca-certificates/.
#                       NOTE: This only works when running from the Deno codebase;
#                       it is not supported in the compiled binary. Use REDIS_CA_CERT_PATH instead.
REDIS_CA_CERT_FILE=

# --redis.ca-cert-path : Full path to the CA certificate file on disk.
REDIS_CA_CERT_PATH=

# --disable-redis : Disable Redis connection ("true" / "1" = disabled, default = enabled).
DISABLE_REDIS=false

# ── Queue & Worker Mediators settings ──────────────────────────────────────
# These variables control the queue behaviors and fallback gracefully to defaults
# when left unconfigured. They map to CLI flags with similar names, where flags
# take precedence.

# --queue-batch-size : Batch size for processing messages concurrently.
QUEUE_BATCH_SIZE=

# --queue-max-retries : Maximum number of retries per batch in case of an error.
QUEUE_MAX_RETRIES=

# --in-memory-processing-hwm : Default high water mark for in-memory processing workers.
IN_MEMORY_PROCESSING_HWM=

# --in-memory-insert-hwm : Default high water mark for the in-memory insert worker.
IN_MEMORY_INSERT_HWM=

# --worker-healthcheck-interval : Interval for worker healthcheck in milliseconds.
WORKER_HEALTHCHECK_INTERVAL=

# --worker-pending-min-duration-threshold : Threshold for claiming pending messages in milliseconds.
WORKER_PENDING_MIN_DURATION_THRESHOLD=

# --xread-block-duration : Duration in milliseconds for XREAD BLOCK calls in Redis.
#                          Controls how long workers wait for new messages before timing out.
#                          Lower values increase responsiveness, higher values reduce CPU usage.
XREAD_BLOCK_DURATION=

# --processing-workers-count : Number of concurrent processing workers to spawn per ADM level.
#                              Defaults to 2. Increase for better throughput on large datasets.
PROCESSING_WORKERS_COUNT=2

# ── REST API Settings ────────────────────────────────────────────────────────

# The listening port for the Mada ADM REST API application.
REST_API_PORT=8000

# Version integers for the static ADM GeoJSON layer data at each administrative level.
# Incrementing these values forces the client to download the updated GeoJSON layers
# instead of using the previously cached versions in the browser.
PROVINCE_ADM_GEOJSON_VERSION=
REGION_ADM_GEOJSON_VERSION=
DISTRICT_ADM_GEOJSON_VERSION=
COMMUNE_ADM_GEOJSON_VERSION=
FOKONTANY_ADM_GEOJSON_VERSION=

# ── Fresh Map Viewer Settings ────────────────────────────────────────────────

# The base URL of the Mada ADM REST API used by the Fresh-based Map Viewer.
FRESH_PUBLIC_REST_API_BASE_URL="http://localhost:8000"

# Number of administrative entities to display per page in the global level filtering 
# search results (within the Map Viewer's ADM Explorer).
FRESH_PUBLIC_GLOBAL_MODE_ADM_ENTITIES_COUNT=10

# Number of administrative entities to display per page in the hierarchical cascade 
# search results (within the Map Viewer's ADM Explorer).
FRESH_PUBLIC_CASCADE_MODE_ADM_ENTITIES_COUNT=10

# Minimum character length required in the ADM Explorer search inputs before triggering 
# an entity search API call.
FRESH_PUBLIC_SEARCH_MIN_LENGTH=3

# Debounce delay in milliseconds before triggering an ADM entity search API call after 
# typing in the ADM Explorer search inputs.
FRESH_PUBLIC_SEARCH_DEBOUNCE_DELAY=300

# Whether the page content drawer is open by default.
FRESH_PUBLIC_PAGE_CONTENT_DRAWER_DEFAULT_OPEN=

# Unreferenced ADM GeoJSON data cleanup interval in seconds.
FRESH_PUBLIC_UNREFERENCED_ADM_GEOJSON_CLEANUP_INTERVAL=300

# The maximum time in milliseconds to wait for a geolocation response.
FRESH_PUBLIC_GEOLOCATION_TIMEOUT=10000

# The maximum distance in meters between two consecutive geolocation coordinates 
# to be considered as a new coordinate entry. (1.1 meters precision)
FRESH_PUBLIC_GEOLOCATION_COORDINDATE_EPSILON=0.00001
